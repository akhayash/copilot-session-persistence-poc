FROM mcr.microsoft.com/dotnet/sdk:10.0

WORKDIR /src
COPY . .

RUN dotnet restore CopilotSessionPersistencePoc.slnx \
    && dotnet build CopilotSessionPersistencePoc.slnx \
        --no-restore \
        --configuration Release \
        -p:UseSharedCompilation=false

ENTRYPOINT ["dotnet", "test", "CopilotSessionPersistencePoc.slnx", "--no-build", "--configuration", "Release", "--nologo", "--filter", "FullyQualifiedName~AzureStorageMultiNodeIntegrationTests"]
