{
  "Persistence": {
    "Backend": "Sqlite",
    "DatabasePath": "data/copilot-sessions.db",
    "BusyTimeoutMilliseconds": 5000
  },
  "AzureStorage": {
    "SessionFsContainer": "sessionfs",
    "SessionLocksContainer": "session-locks",
    "ArtifactsContainer": "artifacts",
    "AppSessionsTable": "appsessions",
    "MaximumWriteAttempts": 8
  },
  "Copilot": {
    "CliUrl": "http://localhost:4321",
    "DefaultModel": "gpt-5-mini",
    "ResponseTimeout": "00:05:00"
  },
  "Diagnostics": {
    "Enabled": true,
    "MaximumPreviewCharacters": 65536
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
